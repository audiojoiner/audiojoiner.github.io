---
import { languages, type SupportedLanguage } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';

interface Props {
  currentLang?: SupportedLanguage;
}

const { currentLang = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<div class="relative group">
  <!-- Language Dropdown Trigger Button -->
  <button
    type="button"
    class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-medium transition-all shadow-2xs focus:outline-hidden focus:ring-2 focus:ring-teal-500/20"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Select language"
  >
    <!-- Globe Icon -->
    <svg class="w-3.5 h-3.5 text-teal-600 dark:text-teal-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z" />
    </svg>
    <span class="font-semibold">{languages[currentLang] || 'English'}</span>
    <!-- Chevron -->
    <svg class="w-3 h-3 text-slate-400 dark:text-slate-500 group-hover:text-slate-600 dark:group-hover:text-slate-300 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu using crawlable HTML <a> tags for SEO -->
  <div class="absolute right-0 mt-1.5 w-40 origin-top-right rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-lg py-1.5 z-50 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 transform scale-95 group-hover:scale-100">
    <div class="px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 border-b border-slate-100 dark:border-slate-800 mb-1">
      Select Language
    </div>

    {Object.entries(languages).map(([langKey, langName]) => {
      const isSelected = langKey === currentLang;
      const targetHref = getLocalizedPath(currentPath, langKey as SupportedLanguage);

      return (
        <a
          href={targetHref}
          class={`flex items-center justify-between px-3 py-2 text-xs font-medium transition-colors ${
            isSelected
              ? 'bg-teal-50 dark:bg-teal-950/50 text-teal-900 dark:text-teal-300 font-bold'
              : 'text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'
          }`}
          aria-current={isSelected ? 'page' : undefined}
        >
          <span>{langName}</span>
          {isSelected && (
            <svg class="w-3.5 h-3.5 text-teal-600 dark:text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          )}
        </a>
      );
    })}
  </div>
</div>
