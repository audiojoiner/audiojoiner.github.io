---
import Layout from '../../layouts/Layout.astro';
import AudioJoiner from '../../components/AudioJoiner.jsx';
import { languages, defaultLang, type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import {
  ShieldCheck,
  Zap,
  Lock,
  Layers,
  HelpCircle,
  FileAudio,
  Sparkles,
  Scissors,
} from 'lucide-react';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((l) => l !== defaultLang)
    .map((lang) => ({
      params: { lang },
    }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);

const featureIcons = [
  Lock,
  Scissors,
  Sparkles,
  FileAudio,
  Zap,
  Layers,
];
---

<Layout
  lang={lang}
  title={t.seo.title}
  description={t.seo.description}
>
  <div class="max-w-5xl mx-auto px-3 sm:px-4 py-8 sm:py-12 space-y-12 sm:space-y-16">
    <!-- Hero Section -->
    <section class="text-center space-y-3 sm:space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-50 dark:bg-teal-950/50 border border-teal-200 dark:border-teal-800/80 text-teal-800 dark:text-teal-300 text-xs font-semibold shadow-2xs">
        <ShieldCheck className="w-4 h-4 text-teal-600 dark:text-teal-400 flex-shrink-0" />
        <span>{t.hero.badge}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
        {t.hero.h1Line1} <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-teal-800 dark:from-teal-400 dark:to-teal-200">
          {t.hero.h1Gradient}
        </span>
      </h1>

      <p class="text-sm sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto">
        {t.hero.subtitle}
      </p>
    </section>

    <!-- Master Interactive Audio Joiner App (React Island) -->
    <section id="app" class="relative">
      <AudioJoiner client:load i18n={t.app} />
    </section>

    <!-- Step-by-Step "How to Merge Audio Files" Guide -->
    <section id="how-it-works" class="pt-8 border-t border-slate-200 dark:border-slate-800">
      <div class="text-center space-y-2 mb-8 sm:mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
          {t.howItWorks.title}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-lg mx-auto">
          {t.howItWorks.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        {t.howItWorks.steps.map((step) => (
          <div class="bg-white dark:bg-slate-900 rounded-xl p-5 sm:p-6 border border-slate-200 dark:border-slate-800 shadow-2xs relative flex flex-col items-start hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-teal-50 dark:bg-teal-950/60 border border-teal-100 dark:border-teal-900 flex items-center justify-center text-teal-700 dark:text-teal-300 font-mono font-bold text-sm mb-3 sm:mb-4">
              {step.num}
            </div>
            <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-1">{step.title}</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              {step.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Key Features Grid -->
    <section id="features" class="pt-8 border-t border-slate-200 dark:border-slate-800">
      <div class="text-center space-y-2 mb-8 sm:mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
          {t.features.title}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-lg mx-auto">
          {t.features.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        {t.features.items.map((item, index) => {
          const Icon = featureIcons[index % featureIcons.length];
          return (
            <div class="bg-white dark:bg-slate-900 rounded-xl p-5 sm:p-6 border border-slate-200 dark:border-slate-800 shadow-2xs flex flex-col gap-3">
              <div class="w-10 h-10 rounded-lg bg-teal-50 dark:bg-teal-950/60 border border-teal-100 dark:border-teal-900 flex items-center justify-center text-teal-600 dark:text-teal-400">
                <Icon className="w-5 h-5" />
              </div>
              <h3 class="text-base font-bold text-slate-900 dark:text-white">{item.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                {item.desc}
              </p>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Frequently Asked Questions (FAQ) -->
    <section id="faq" class="pt-8 border-t border-slate-200 dark:border-slate-800">
      <div class="text-center space-y-2 mb-8 sm:mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
          {t.faq.title}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-lg mx-auto">
          {t.faq.subtitle}
        </p>
      </div>

      <div class="max-w-3xl mx-auto space-y-3 sm:space-y-4">
        {t.faq.items.map((item) => (
          <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-4 sm:p-5 shadow-2xs">
            <h3 class="text-sm sm:text-base font-semibold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
              <HelpCircle className="w-4 h-4 text-teal-600 dark:text-teal-400 flex-shrink-0" />
              <span>{item.q}</span>
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed pl-6">
              {item.a}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
